{
  "version": "0.2.0",
  "configurations": [
  
    {
      "name": "Run JSX Open in Code extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension"
      ]
    }
  ]
}
