{
  "manifest_version": 3,
  "name": "JSX Open in Code (Firefox)",
  "version": "0.1.0",
  "description": "Inspect rendered JSX and open its source in VS Code.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:48732/*"],
  "action": { "default_popup": "popup.html", "default_title": "JSX Open in Code" },
  "content_scripts": [{
    "matches": ["http://localhost/*", "http://127.0.0.1/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "jsx-open-in-code@local.dev",
      "strict_min_version": "121.0"
    }
  }
}
